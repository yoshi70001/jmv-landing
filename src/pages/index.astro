import Hero from '../components/sections/Hero.astro';
import QueEs from '../components/sections/QueEs.astro';
import Identidad from '../components/sections/Identidad.astro';
import Peru from '../components/sections/Peru.astro';
import CentroCercano from '../components/sections/CentroCercano.astro';
import Encuentros from '../components/sections/Encuentros.astro';
