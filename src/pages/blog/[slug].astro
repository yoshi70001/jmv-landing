---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { fechaLarga } from '../../lib/utils';
import { urlAbsoluta } from '../../lib/sitio';

export async function getStaticPaths() {
  const entradas = await getCollection('blog', ({ data }) => !data.draft);
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

const { entrada } = Astro.props;
const { Content } = await render(entrada);

const urlPost = urlAbsoluta(`/blog/${entrada.id}`);

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${urlPost}#post`,
  headline: entrada.data.title,
  description: entrada.data.description,
  image: urlAbsoluta('/og.png'),
  url: urlPost,
  mainEntityOfPage: urlPost,
  inLanguage: 'es-PE',
  datePublished: entrada.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: entrada.data.author },
  publisher: { '@id': urlAbsoluta('/#organizacion') },
  isPartOf: { '@id': urlAbsoluta('/blog/#blog') },
  keywords: entrada.data.tags.join(', '),
};

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: urlAbsoluta('/') },
    { '@type': 'ListItem', position: 2, name: 'Bitácora', item: urlAbsoluta('/blog/') },
    { '@type': 'ListItem', position: 3, name: entrada.data.title, item: urlPost },
  ],
};
---

<Layout title={`${entrada.data.title} | Bitácora JMV`} description={entrada.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(blogPosting)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(migas)} />
  <article class="bg-marfil">
    <header class="bg-marino pt-28 pb-12 sm:pt-32 sm:pb-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <a
          href="/blog"
          class="inline-block border-b-2 border-dorado font-body text-xs font-bold uppercase tracking-widest text-dorado transition-colors hover:text-marfil"
        >
          ← Bitácora
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          {
            entrada.data.tags.map((tag) => (
              <span class="rounded-full bg-white/10 px-3 py-0.5 font-body text-[0.65rem] font-bold uppercase tracking-widest text-marfil ring-1 ring-marfil/25">
                {tag}
              </span>
            ))
          }
        </div>

        <h1
          class="mt-5 font-display text-[clamp(2rem,5.5vw,4rem)] leading-[1.08] font-semibold tracking-tight text-marfil"
        >
          {entrada.data.title}
        </h1>

        <p class="mt-5 font-body text-sm font-bold uppercase tracking-widest text-celeste-niebla">
          <time datetime={entrada.data.pubDate.toISOString()}>{fechaLarga(entrada.data.pubDate)}</time>
          <span class="mx-2 text-dorado">✦</span>
          {entrada.data.author}
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="prose-edit">
        <Content />
      </div>

      <div class="mt-14 rounded-3xl bg-gradient-to-br from-dorado-suave to-white p-7 shadow-nube ring-1 ring-dorado/40 sm:p-9">
        <p class="font-display text-xl font-semibold tracking-tight text-marino sm:text-2xl">¿Quieres vivir esto?</p>
        <p class="mt-2 font-body font-medium text-tinta/85">
          No necesitas ser perfecto ni saberlo todo — solo ganas de caminar.
        </p>
        <a
          href="/#contacto"
          class="boton boton-primario mt-5 inline-block"
        >
          Únete a JUMAVI →
        </a>
      </div>

      <a
        href="/blog"
        class="mt-10 inline-block border-b-2 border-dorado pb-0.5 font-body text-sm font-bold uppercase tracking-widest text-marino transition-colors hover:text-marino-noche"
      >
        ← Todas las crónicas
      </a>
    </div>
  </article>
</Layout>
