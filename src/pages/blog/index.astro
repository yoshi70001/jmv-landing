---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fechaLarga } from '../../lib/utils';

const entradas = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const todasLasTags = [...new Set(entradas.flatMap((e) => e.data.tags))].sort();
---

<Layout
  title="Bitácora JUMAVI | Blog de la JMV — Juventud Mariana Vicentina"
  description="Crónicas de actividades de la JMV (JUMAVI): encuentros semanales, jornadas de servicio, retiros y formación. Una crónica por cada semana de actividad."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': 'https://jumavi.org/blog/#blog',
    name: 'Bitácora JUMAVI',
    url: 'https://jumavi.org/blog/',
    inLanguage: 'es-PE',
    description: 'Crónicas de actividades de la Juventud Mariana Vicentina (JMV).',
    publisher: { '@id': 'https://jumavi.org/#organizacion' },
    blogPost: entradas.map((entrada) => ({
      '@type': 'BlogPosting',
      headline: entrada.data.title,
      url: `https://jumavi.org/blog/${entrada.id}/`,
      datePublished: entrada.data.pubDate.toISOString(),
    })),
  })} />
  <section class="bg-marino pt-28 pb-14 sm:pt-32 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="chip chip-invertida">Crónicas de actividad</p>
      <h1 class="mt-6 font-display text-[clamp(2.8rem,8vw,6.5rem)] leading-[1.02] font-semibold tracking-tight text-marfil">
        Bitá<span class="text-dorado">cora</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-marfil/85">
        Lo que hicimos, lo que aprendimos y lo que se viene. Una crónica por cada
        semana o mes de actividad.
      </p>
    </div>
  </section>

  <section class="bg-marfil py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <!-- Filtro de tags -->
      <div class="mb-10 flex flex-wrap gap-2.5" role="group" aria-label="Filtrar por etiqueta">
        <button
          type="button"
          data-filtro-tag="todas"
          aria-pressed="true"
          class="rounded-full border border-tinta/25 bg-white px-4 py-1.5 font-body text-xs font-bold uppercase tracking-widest text-tinta transition-colors hover:border-marino aria-pressed:border-marino aria-pressed:bg-marino aria-pressed:text-marfil"
        >
          Todas
        </button>
        {
          todasLasTags.map((tag) => (
            <button
              type="button"
              data-filtro-tag={tag}
              aria-pressed="false"
              class="rounded-full border border-tinta/25 bg-white px-4 py-1.5 font-body text-xs font-bold uppercase tracking-widest text-tinta transition-colors hover:border-marino aria-pressed:border-marino aria-pressed:bg-marino aria-pressed:text-marfil"
            >
              {tag}
            </button>
          ))
        }
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          entradas.map((entrada, i) => (
            <article
              data-post-tags={entrada.data.tags.join(',')}
              class="tarjeta flex flex-col overflow-hidden"
              style={`--reveal-delay: ${(i % 3) * 0.06}s`}
              data-reveal
            >
              <a href={`/blog/${entrada.id}`} class="flex grow flex-col">
                <div class="flex items-center justify-between gap-3 bg-celeste-niebla px-5 py-3">
                  <time datetime={entrada.data.pubDate.toISOString()} class="font-body text-xs font-bold uppercase tracking-widest text-marino">
                    {fechaLarga(entrada.data.pubDate)}
                  </time>
                  <span class="text-dorado" aria-hidden="true">✦</span>
                </div>
                <div class="flex grow flex-col p-6">
                  <h2 class="font-display text-xl font-semibold leading-snug tracking-tight text-tinta sm:text-2xl">
                    {entrada.data.title}
                  </h2>
                  <p class="mt-3 grow text-sm leading-relaxed text-tinta/80">
                    {entrada.data.description}
                  </p>
                  <div class="mt-5 flex flex-wrap items-center gap-2">
                    {entrada.data.tags.map((tag) => (
                      <span class="rounded-full bg-dorado-suave px-2.5 py-0.5 font-body text-[0.65rem] font-bold uppercase tracking-widest text-tinta/85">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <span class="mt-4 border-b-2 border-dorado pb-0.5 self-start font-body text-xs font-bold uppercase tracking-widest text-marino">
                    Leer crónica →
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <p id="blog-vacio" hidden class="rounded-2xl border-2 border-dashed border-tinta/30 p-10 text-center font-body font-bold uppercase tracking-widest text-tinta/55">
        No hay crónicas con esa etiqueta (todavía).
      </p>
    </div>
  </section>
</Layout>

<script>
  function conectarFiltro() {
    const botones = document.querySelectorAll('[data-filtro-tag]');
    const tarjetas = document.querySelectorAll('[data-post-tags]');
    const vacio = document.getElementById('blog-vacio');
    if (botones.length === 0) return;

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const tag = boton.getAttribute('data-filtro-tag');
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        let visibles = 0;
        tarjetas.forEach((tarjeta) => {
          const tags = (tarjeta.getAttribute('data-post-tags') || '').split(',');
          const mostrar = !tag || tag === 'todas' || tags.includes(tag);
          tarjeta.toggleAttribute('hidden', !mostrar);
          if (mostrar) visibles++;
        });

        vacio?.toggleAttribute('hidden', visibles > 0);
      });
    });
  }

  document.addEventListener('astro:page-load', conectarFiltro);
</script>
