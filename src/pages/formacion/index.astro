---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fechaLarga } from '../../lib/utils';

const temas = (await getCollection('formacion', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const todosLosTemas = [...new Set(temas.map((t) => t.data.tema))];

const estilosTema: Record<string, { fondo: string; texto: string }> = {
  mariana: { fondo: 'bg-marino', texto: 'text-marfil' },
  vicenciana: { fondo: 'bg-marino-noche', texto: 'text-marfil' },
  eclesial: { fondo: 'bg-celeste', texto: 'text-tinta' },
  laical: { fondo: 'bg-dorado', texto: 'text-tinta' },
  general: { fondo: 'bg-celeste-niebla', texto: 'text-tinta' },
};
---

<Layout
  title="Formación JMV | Temas de formación JUMAVI — Juventud Mariana Vicentina"
  description="Temas de formación de la JMV (JUMAVI) semana a semana: espiritualidad mariana, carisma vicenciano, vida eclesial y laical. Lo que aprendemos, registrado para ti."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://jumavi.org/formacion/#formacion',
    name: 'Formación JMV',
    url: 'https://jumavi.org/formacion/',
    inLanguage: 'es-PE',
    description: 'Temas de formación de la Juventud Mariana Vicentina (JMV): mariana, vicenciana, eclesial y laical.',
    isPartOf: { '@id': 'https://jumavi.org/#sitio' },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: temas.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `https://jumavi.org/formacion/${t.id}/`,
        name: t.data.title,
      })),
    },
  })} />

  <section class="bg-marino pt-28 pb-14 sm:pt-32 sm:pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="chip chip-invertida">Lo que aprendemos semana a semana</p>
      <h1 class="mt-6 font-display text-[clamp(2.8rem,8vw,6.5rem)] leading-[1.02] font-semibold tracking-tight text-marfil">
        Forma<span class="text-dorado">ción</span>
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-marfil/85">
        Los temas que desarrollamos en los encuentros de la JMV, organizados por
        nuestros cuatro pilares: mariana, vicenciana, eclesial y laical.
      </p>
    </div>
  </section>

  <section class="bg-marfil py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <!-- Filtro por tema -->
      <div class="mb-10 flex flex-wrap gap-2.5" role="group" aria-label="Filtrar por tema">
        <button
          type="button"
          data-filtro-tema="todos"
          aria-pressed="true"
          class="rounded-full border border-tinta/25 bg-white px-4 py-1.5 font-body text-xs font-bold uppercase tracking-widest text-tinta transition-colors hover:border-marino aria-pressed:border-marino aria-pressed:bg-marino aria-pressed:text-marfil"
        >
          Todos
        </button>
        {
          todosLosTemas.map((tema) => (
            <button
              type="button"
              data-filtro-tema={tema}
              aria-pressed="false"
              class="rounded-full border border-tinta/25 bg-white px-4 py-1.5 font-body text-xs font-bold uppercase tracking-widest text-tinta transition-colors hover:border-marino aria-pressed:border-marino aria-pressed:bg-marino aria-pressed:text-marfil"
            >
              {tema}
            </button>
          ))
        }
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          temas.map((tema, i) => {
            const estilo = estilosTema[tema.data.tema] ?? estilosTema.general;
            return (
              <article
                data-post-tema={tema.data.tema}
                class="tarjeta flex flex-col overflow-hidden"
                style={`--reveal-delay: ${(i % 3) * 0.06}s`}
                data-reveal
              >
                <a href={`/formacion/${tema.id}`} class="flex grow flex-col">
                  <div class:list={[
                    'flex items-center justify-between gap-3 px-5 py-3',
                    estilo.fondo,
                    estilo.texto,
                  ]}>
                    <span class="font-body text-xs font-bold uppercase tracking-chip">
                      {tema.data.tema}
                    </span>
                    <time datetime={tema.data.pubDate.toISOString()} class="font-body text-xs font-bold opacity-80">
                      {fechaLarga(tema.data.pubDate)}
                    </time>
                  </div>
                  <div class="flex grow flex-col p-6">
                    <h2 class="font-display text-xl font-semibold leading-snug tracking-tight text-tinta sm:text-2xl">
                      {tema.data.title}
                    </h2>
                    <p class="mt-3 grow text-sm leading-relaxed text-tinta/80">
                      {tema.data.description}
                    </p>
                    <span class="mt-5 border-b-2 border-dorado pb-0.5 self-start font-body text-xs font-bold uppercase tracking-widest text-marino">
                      Leer tema →
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>

      <p id="formacion-vacio" hidden class="rounded-2xl border-2 border-dashed border-tinta/30 p-10 text-center font-body font-bold uppercase tracking-widest text-tinta/70">
        No hay temas con esa etiqueta (todavía).
      </p>
    </div>
  </section>
</Layout>

<script>
  function conectarFiltroTema() {
    const botones = document.querySelectorAll('[data-filtro-tema]');
    const tarjetas = document.querySelectorAll('[data-post-tema]');
    const vacio = document.getElementById('formacion-vacio');
    if (botones.length === 0) return;

    botones.forEach((boton) => {
      boton.addEventListener('click', () => {
        const tema = boton.getAttribute('data-filtro-tema');
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b === boton)));

        let visibles = 0;
        tarjetas.forEach((tarjeta) => {
          const mostrar = !tema || tema === 'todos' || tarjeta.getAttribute('data-post-tema') === tema;
          tarjeta.toggleAttribute('hidden', !mostrar);
          if (mostrar) visibles++;
        });

        vacio?.toggleAttribute('hidden', visibles > 0);
      });
    });
  }

  document.addEventListener('astro:page-load', conectarFiltroTema);
</script>
