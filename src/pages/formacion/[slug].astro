---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { fechaLarga } from '../../lib/utils';
import { urlAbsoluta } from '../../lib/sitio';

export async function getStaticPaths() {
  const temas = await getCollection('formacion', ({ data }) => !data.draft);
  return temas.map((tema) => ({
    params: { slug: tema.id },
    props: { tema },
  }));
}

const { tema } = Astro.props;
const { Content } = await render(tema);

const urlTema = urlAbsoluta(`/formacion/${tema.id}`);

const coloresTema: Record<string, string> = {
  mariana: 'bg-marino',
  vicenciana: 'bg-marino-noche',
  eclesial: 'bg-celeste',
  laical: 'bg-dorado',
  general: 'bg-celeste-niebla',
};

const articulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${urlTema}#articulo`,
  headline: tema.data.title,
  description: tema.data.description,
  image: urlAbsoluta('/og.png'),
  url: urlTema,
  mainEntityOfPage: urlTema,
  inLanguage: 'es-PE',
  datePublished: tema.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: tema.data.autor },
  publisher: { '@id': urlAbsoluta('/#organizacion') },
  isPartOf: { '@id': urlAbsoluta('/formacion/#formacion') },
  articleSection: tema.data.tema,
  keywords: `formación JMV, ${tema.data.tema}, JUMAVI`,
};

const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: urlAbsoluta('/') },
    { '@type': 'ListItem', position: 2, name: 'Formación', item: urlAbsoluta('/formacion/') },
    { '@type': 'ListItem', position: 3, name: tema.data.title, item: urlTema },
  ],
};
---

<Layout title={`${tema.data.title} | Formación JMV`} description={tema.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articulo)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(migas)} />

  <article class="bg-marfil">
    <header class="bg-marino pt-28 pb-12 sm:pt-32 sm:pb-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <a
          href="/formacion"
          class="inline-block border-b-2 border-dorado font-body text-xs font-bold uppercase tracking-widest text-dorado transition-colors hover:text-marfil"
        >
          ← Formación
        </a>

        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class:list={[
            'rounded-full px-3 py-0.5 font-body text-xs font-bold uppercase tracking-chip ring-1',
            coloresTema[tema.data.tema] === 'bg-dorado' || coloresTema[tema.data.tema] === 'bg-celeste' || coloresTema[tema.data.tema] === 'bg-celeste-niebla'
              ? 'bg-dorado text-tinta ring-dorado'
              : 'bg-marino text-marfil ring-marfil/30',
          ]}>
            {tema.data.tema}
          </span>
        </div>

        <h1
          class="mt-5 font-display text-[clamp(2rem,5.5vw,4rem)] leading-[1.08] font-semibold tracking-tight text-marfil"
        >
          {tema.data.title}
        </h1>

        <p class="mt-5 font-body text-sm font-bold uppercase tracking-widest text-celeste-niebla">
          <time datetime={tema.data.pubDate.toISOString()}>{fechaLarga(tema.data.pubDate)}</time>
          <span class="mx-2 text-dorado">✦</span>
          {tema.data.autor}
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="prose-edit">
        <Content />
      </div>

      <div class="mt-14 rounded-3xl bg-gradient-to-br from-dorado-suave to-white p-7 shadow-nube ring-1 ring-dorado/40 sm:p-9">
        <p class="font-display text-xl font-semibold tracking-tight text-marino sm:text-2xl">¿Quieres aprender con nosotros?</p>
        <p class="mt-2 font-body font-medium text-tinta/85">
          Estos temas se viven en los encuentros semanales de la JMV — la formación
          se disfruta mejor en comunidad.
        </p>
        <a
          href="/#contacto"
          class="boton boton-primario mt-5 inline-block"
        >
          Únete a JUMAVI →
        </a>
      </div>

      <a
        href="/formacion"
        class="mt-10 inline-block border-b-2 border-dorado pb-0.5 font-body text-sm font-bold uppercase tracking-widest text-marino transition-colors hover:text-marino-noche"
      >
        ← Todos los temas
      </a>
    </div>
  </article>
</Layout>
