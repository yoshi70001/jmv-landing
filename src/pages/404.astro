---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Página no encontrada | JUMAVI"
  description="La página que buscas no existe en el sitio de JUMAVI (Juventud Mariana Vicentina). Vuelve al inicio o visita la Bitácora."
  noindex
>
  <section class="flex min-h-screen flex-col items-center justify-center bg-marino px-4 py-24 text-center">
    <p class="chip chip-invertida">Error 404</p>
    <h1 class="mt-6 font-display text-[clamp(4rem,18vw,12rem)] leading-none font-semibold text-marfil/95">
      404
    </h1>
    <p class="mt-4 max-w-md text-lg leading-relaxed text-marfil/85">
      Esta página no existe — pero en la JMV ninguna puerta se cierra del todo.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="boton boton-grande boton-dorado"
      >
        ← Volver al inicio
      </a>
      <a
        href="/blog"
        class="boton boton-grande boton-noche ring-1 ring-marfil/30"
      >
        Ir a la Bitácora ✦
      </a>
    </div>
  </section>
</Layout>
