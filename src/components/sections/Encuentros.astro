---
import { Image } from 'astro:assets';
import { encuentros } from '../../lib/datos/encuentros';
import { fechaLarga } from '../../lib/utils';

/**
 * Muestra los próximos encuentros ordenados por fecha.
 * - Los eventos vencidos nunca aparecen como futuros.
 * - Si no hay eventos confirmados, muestra una invitación general
 *   (no se inventa programación).
 * Nota: al ser un sitio estático, la fecha se evalúa al compilar;
 * redesplegar periódicamente mantiene la lista al día.
 */

const ahora = new Date();

const proximos = encuentros
  .filter((e) => {
    const fecha = new Date(`${e.fecha}T${e.hora ?? '23:59'}`);
    return fecha >= ahora;
  })
  .sort((a, b) => `${a.fecha}T${a.hora ?? '23:59'}`.localeCompare(`${b.fecha}T${b.hora ?? '23:59'}`))
  .slice(0, 3);
---

<section id="actividades" class="scroll-mt-24 border-y border-tinta/10 bg-marfil-2/50 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="chip">Agenda</p>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,6.5vw,5rem)] leading-[1.05] font-semibold tracking-tight text-tinta">
          Próximos <span class="text-marino">encuentros</span>
        </h2>
      </div>
      <p class="max-w-sm text-lg leading-relaxed text-tinta/75">
        Lo que se viene: encuentros, jornadas y celebraciones donde puedes sumarte.
      </p>
    </div>

    {
      proximos.length > 0 ? (
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {proximos.map((encuentro, i) => (
            <article
              class="tarjeta flex flex-col overflow-hidden"
              style={`--reveal-delay: ${i * 0.08}s`}
              data-reveal
            >
              {encuentro.imagen && (
                <Image
                  src={encuentro.imagen.src}
                  alt={encuentro.imagen.alt ?? `Imagen de ${encuentro.nombre}`}
                  widths={[640, 960]}
                  sizes="(min-width: 1024px) 30vw, 92vw"
                  quality={75}
                  class="aspect-[16/9] w-full bg-celeste-niebla object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="flex grow flex-col p-6">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <time datetime={`${encuentro.fecha}T${encuentro.hora ?? '00:00'}`} class="font-display text-lg font-semibold text-marino">
                    {fechaLarga(new Date(`${encuentro.fecha}T12:00`))}
                  </time>
                  {encuentro.hora && (
                    <span class="font-body text-sm font-bold text-tinta/60">{encuentro.hora} h</span>
                  )}
                </div>
                <h3 class="mt-1.5 font-display text-xl font-semibold tracking-tight text-tinta sm:text-2xl">
                  {encuentro.nombre}
                </h3>
                {encuentro.lugar && (
                  <p class="mt-1.5 font-body text-sm font-medium text-tinta/65">📍 {encuentro.lugar}</p>
                )}
                <p class="mt-3 grow text-sm leading-relaxed text-tinta/80">{encuentro.descripcion}</p>
                {encuentro.enlace && (
                  <a
                    href={encuentro.enlace}
                    class="mt-5 self-start border-b-2 border-dorado pb-0.5 font-body text-xs font-bold uppercase tracking-widest text-marino transition-colors hover:text-marino-noche"
                  >
                    Más información →
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-12" data-reveal style="--reveal-delay: 0.1s">
          <div class="mx-auto max-w-3xl rounded-3xl bg-gradient-to-br from-dorado-suave to-white p-8 text-center shadow-nube ring-1 ring-dorado/40 sm:p-10">
            <span class="animate-flotar inline-block font-display text-4xl font-semibold text-dorado-tinta" aria-hidden="true">✦</span>
            <p class="mt-3 font-display text-2xl font-semibold tracking-tight text-marino">
              La agenda se está preparando
            </p>
            <p class="mx-auto mt-3 max-w-md leading-relaxed text-tinta/80">
              Muy pronto publicaremos los próximos encuentros. Mientras tanto,
              conoce lo que ya vivimos y escríbenos para sumarte a un grupo cerca de ti.
            </p>
            <div class="mt-6 flex flex-wrap justify-center gap-4">
              <a
                href="/blog"
                class="boton boton-primario"
              >
                Ver actividades pasadas
              </a>
              <a
                href="/#contacto"
                class="boton boton-dorado"
              >
                Quiero sumarme ✦
              </a>
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
