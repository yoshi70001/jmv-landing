---
const voces = [
  {
    quote: 'Llegué por una amiga y me quedé por la gente. Aquí encontré amigos que me empujan a ser mejor.',
    nombre: '[Nombre]',
    detalle: '17 años · [Parroquia]',
    destacada: false,
  },
  {
    quote: 'Pensaba que la fe era aburrida. Después serví en una obra vicenciana y cambió todo.',
    nombre: '[Nombre]',
    detalle: '21 años · [Colegio vicentino]',
    destacada: true,
  },
  {
    quote: 'Ser JUMAVI es tener una segunda familia que celebra contigo y te acompaña cuando cuesta.',
    nombre: '[Nombre]',
    detalle: '24 años · [Ciudad]',
    destacada: false,
  },
];
---

<section id="voces" class="scroll-mt-24 bg-marfil py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="chip">En sus propias palabras</p>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,6.5vw,5rem)] leading-[1.05] font-semibold tracking-tight text-tinta">
          Voces <span class="text-marino">JUMAVI</span>
        </h2>
      </div>
      <p class="max-w-sm text-lg leading-relaxed text-tinta/75">
        Jóvenes reales, historias reales. La nuestra empieza igual: alguien te invita.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal style="--reveal-delay: 0.1s">
      {
        voces.map((voz, i) => (
          <figure
            class:list={[
              'flex flex-col justify-between gap-8 rounded-3xl p-7 sm:p-8',
              voz.destacada
                ? 'bg-marino text-marfil shadow-nube-lg md:-translate-y-3'
                : 'tarjeta',
            ]}
            style={`--reveal-delay: ${0.1 + i * 0.08}s`}
            data-reveal
          >
            <blockquote>
              <span class:list={[
                'block font-display text-5xl leading-none font-semibold',
                voz.destacada ? 'text-dorado' : 'text-dorado',
              ]} aria-hidden="true">
                «
              </span>
              <p class:list={[
                'mt-2 font-display text-xl font-medium italic leading-relaxed',
                voz.destacada ? 'text-marfil' : 'text-tinta',
              ]}>
                {voz.quote}
              </p>
            </blockquote>
            <figcaption class:list={[
              'border-t pt-4 font-body text-sm font-bold uppercase tracking-widest',
              voz.destacada ? 'border-marfil/25 text-marfil' : 'border-tinta/15 text-tinta',
            ]}>
              {voz.nombre}
              <span class:list={[
                'mt-0.5 block text-xs font-medium normal-case tracking-normal',
                voz.destacada ? 'text-marfil/75' : 'text-tinta/65',
              ]}>
                {voz.detalle}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
