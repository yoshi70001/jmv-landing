---
import { contacto } from '../../lib/datos/contacto';

const canales = [
  {
    nombre: 'WhatsApp',
    detalle: contacto.whatsapp.numero,
    accion: 'Chatea ahora',
    href: contacto.whatsapp.enlace,
    destacado: true,
    icono: '💬',
  },
  {
    nombre: 'Correo',
    detalle: contacto.correo.direccion,
    accion: 'Respuesta en 24–48 h',
    href: contacto.correo.enlace,
    destacado: false,
    icono: '✉️',
  },
  {
    nombre: 'Instagram',
    detalle: contacto.instagram.usuario,
    accion: 'Síguenos',
    href: contacto.instagram.enlace,
    destacado: false,
    icono: '📸',
  },
  {
    nombre: 'Facebook',
    detalle: contacto.facebook.nombre,
    accion: 'Únete al grupo',
    href: contacto.facebook.enlace,
    destacado: false,
    icono: '👥',
  },
];
---

<section id="contacto" class="scroll-mt-24 bg-marfil py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div data-reveal>
        <p class="chip">El siguiente paso</p>
        <h2 class="mt-6 font-display text-[clamp(2.4rem,6.5vw,5rem)] leading-[1.05] font-semibold tracking-tight text-tinta">
          ¿Te <span class="subrayado text-marino">sumas</span>?
        </h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed text-tinta/80">
          No necesitas ser perfecto ni saberlo todo — solo ganas de caminar.{" "}
          <strong class="font-bold text-marino">El siguiente paso es sencillo:</strong>{" "}
          escríbenos,{' '}
          <a
            href="/centros"
            class="font-bold text-marino underline decoration-dorado underline-offset-4 transition-colors hover:text-marino-noche"
          >
            encuentra el centro cerca de ti
          </a>{' '}
          o acompañanos en un encuentro. Te respondemos rapidito.
        </p>
        <div class="rayas mt-8 hidden h-4 w-40 rounded-full lg:block" aria-hidden="true"></div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2" style="--reveal-delay: 0.1s" data-reveal>
        {
          canales.map((canal) => (
            <a
              href={canal.href}
              target={canal.href.startsWith('http') ? '_blank' : undefined}
              rel={canal.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class:list={[
                'group flex flex-col justify-between gap-8 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1',
                canal.destacado
                  ? 'bg-marino text-marfil shadow-nube-lg'
                  : 'tarjeta',
              ]}
            >
              <span class="flex items-center justify-between">
                <span class:list={[
                  'font-display text-xl font-semibold tracking-tight sm:text-2xl',
                  canal.destacado && 'text-marfil',
                ]}>
                  {canal.nombre}
                </span>
                <span class="text-2xl" aria-hidden="true">{canal.icono}</span>
              </span>
              <span>
                <span class="block font-body font-bold">{canal.detalle}</span>
                <span class:list={[
                  'mt-1 inline-block border-b-2 pb-0.5 font-body text-xs font-bold uppercase tracking-widest transition-colors',
                  canal.destacado
                    ? 'border-dorado text-dorado'
                    : 'border-dorado text-marino group-hover:text-marino-noche',
                ]}>
                  {canal.accion} →
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
