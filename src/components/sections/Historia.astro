---
import { hitosResumen, presente } from '../../lib/datos/hitos';
---

<section id="historia" class="scroll-mt-24 bg-marfil py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="chip">Desde 1830</p>
        <h2 class="mt-6 font-display text-[clamp(2.2rem,5.5vw,4.2rem)] leading-[1.05] font-semibold tracking-tight text-tinta">
          Nuestra <span class="text-marino">historia</span>
        </h2>
      </div>
      <a
        href="/historia"
        class="boton bg-marino px-6 py-3 font-body text-sm font-bold uppercase tracking-widest text-marfil"
      >
        Descubre nuestra historia →
      </a>
    </div>

    <p class="mt-8 max-w-2xl text-lg leading-relaxed text-tinta/85" data-reveal style="--reveal-delay: 0.06s">
      Lo que empezó en París con una joven y una apari­ción, hoy es un movimiento
      mundial que también camina en el Perú. Estos son los hitos que nos trajeron hasta aquí.
    </p>

    <ol class="mt-12 grid gap-6 md:grid-cols-3" data-reveal style="--reveal-delay: 0.1s">
      {
        hitosResumen.map((hito, i) => (
          <li
            class="tarjeta relative flex flex-col p-6 sm:p-7"
            style={`--reveal-delay: ${0.1 + i * 0.06}s`}
            data-reveal
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="font-display text-4xl font-semibold italic text-marino">{hito.anio}</span>
              <span class="chip">{hito.tag}</span>
            </div>
            <h3 class="mt-3 font-display text-xl font-semibold tracking-tight text-tinta">{hito.titulo}</h3>
            <p class="mt-2.5 grow text-sm leading-relaxed text-tinta/80">{hito.texto}</p>
          </li>
        ))
      }
    </ol>

    <div
      class="mt-8 flex flex-col items-start justify-between gap-5 rounded-3xl bg-gradient-to-br from-dorado-suave to-white p-7 shadow-nube ring-1 ring-dorado/40 sm:flex-row sm:items-center sm:p-8"
      data-reveal
      style="--reveal-delay: 0.2s"
    >
      <p class="max-w-xl font-body font-bold text-tinta">
        <span class="mr-2 font-display text-2xl font-semibold text-marino">Hoy.</span>
        {presente.texto}
      </p>
      <a
        href="/historia"
        class="shrink-0 rounded-full border-2 border-marino/25 px-5 py-2.5 font-body text-xs font-bold uppercase tracking-widest text-marino transition-colors hover:border-marino hover:bg-celeste-niebla"
      >
        Ver cronología completa →
      </a>
    </div>
  </div>
</section>
