---
import { Picture } from 'astro:assets';
import { fotos } from '../../lib/fotos';
import { contacto } from '../../lib/datos/contacto';

const stats = [
  { valor: '1830', etiqueta: 'Origen' },
  { valor: '78', etiqueta: 'Países' },
  { valor: '+30K', etiqueta: 'Jóvenes' },
];

const lema = ['Eclesial', 'Laical', 'Mariana', 'Vicenciana'];
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden pt-28 sm:pt-36">
  <!-- Fondo degradado suave -->
  <div class="absolute inset-x-0 top-0 h-[560px] bg-gradient-to-b from-celeste-niebla via-marfil to-marfil" aria-hidden="true"></div>
  <!-- Acento brutalista puntual: franja dorada -->
  <div class="absolute top-32 -right-12 hidden h-8 w-56 rotate-6 rounded-full bg-dorado/70 lg:block" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <!-- Columna de texto -->
      <div>
        <p class="chip" data-reveal>
          Para jóvenes de 15 a 35 ✦ desde 1830
        </p>

        <h1
          class="mt-7 font-display text-[clamp(2.9rem,7.5vw,5.8rem)] leading-[1.02] font-semibold tracking-tight text-marino"
          data-reveal
          style="--reveal-delay: 0.08s"
        >
          Vivir tu fe<br />
          <span class="subrayado text-tinta">sin dejar de ser tú</span>
        </h1>

        <p class="mt-5 font-body text-sm font-bold uppercase tracking-amplio text-tinta/60" data-reveal style="--reveal-delay: 0.12s">
          JUMAVI · Juventud Mariana Vicentina
        </p>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-tinta/85 sm:text-xl" data-reveal style="--reveal-delay: 0.16s">
          Formarte, evangelizar y servir a los más necesitados, siguiendo a{" "}
          <strong class="font-bold text-marino">María</strong> y el carisma de{" "}
          <strong class="font-bold text-marino">San Vicente de Paúl</strong>.
          Aquí nadie camina solo.
        </p>

        <div class="mt-9 flex flex-wrap gap-4" data-reveal style="--reveal-delay: 0.24s">
          <a
            href={contacto.whatsapp.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="boton boton-grande boton-dorado"
          >
            Quiero unirme ✦
          </a>
          <a
            href="#somos"
            class="boton boton-grande boton-primario"
          >
            Conoce JUMAVI →
          </a>
        </div>
      </div>

      <!-- Columna fotográfica editorial -->
      <div class="relative" data-reveal style="--reveal-delay: 0.2s">
        <!-- Bloque dorado desplazado: guiño brutalista -->
        <div class="absolute -top-4 -right-4 h-full w-full rounded-[2rem] bg-dorado/60" aria-hidden="true"></div>

        <figure class="marco-foto relative">
          <Picture
            src={fotos.hero.principal.src}
            alt={fotos.hero.principal.alt}
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1024px) 44vw, 92vw"
            formats={['avif']}
            fallbackFormat="webp"
            class="aspect-[4/3] w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="absolute bottom-4 right-4 rounded-full bg-marfil/90 px-4 py-1.5 text-xs font-bold uppercase tracking-chip text-marino backdrop-blur-sm">
            {fotos.hero.principal.caption}
          </figcaption>
        </figure>

        <!-- Foto secundaria superpuesta, estilo polaroid editorial -->
        <figure class="absolute -bottom-12 -left-2 w-36 rotate-[-4deg] rounded-2xl border-[6px] border-white bg-white shadow-nube-lg sm:-left-6 sm:w-44">
          <Picture
            src={fotos.hero.columna.src}
            alt={fotos.hero.columna.alt}
            widths={[220, 440]}
            sizes="(min-width: 640px) 176px, 144px"
            formats={['avif']}
            fallbackFormat="webp"
            class="aspect-[4/3] w-full rounded-xl bg-celeste-niebla object-cover"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="px-2 py-1.5 text-center font-display text-[0.7rem] font-semibold italic text-tinta/70">
            {fotos.hero.columna.caption}
          </figcaption>
        </figure>
      </div>
    </div>

    <!-- Stats -->
    <dl class="mt-24 grid grid-cols-3 gap-4 sm:gap-6" data-reveal style="--reveal-delay: 0.3s">
      {
        stats.map((stat) => (
          <div class="tarjeta px-3 py-6 text-center sm:px-6 sm:py-8">
            <dt class="mt-2 block font-body text-[0.65rem] font-bold uppercase tracking-chip text-tinta/70 sm:text-xs">
              {stat.etiqueta}
            </dt>
            <dd class="font-display text-3xl font-semibold text-marino sm:text-5xl lg:text-6xl">{stat.valor}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <!-- Cinta marquee -->
  <div class="overflow-hidden bg-marino py-2.5" aria-hidden="true">
    <div class="animate-marquee flex w-max">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {lema.map((palabra) => (
              <span class="flex items-center font-body text-sm font-bold uppercase tracking-amplio text-marfil sm:text-base">
                <span class="px-6">{palabra}</span>
                <span class="text-dorado">✦</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
