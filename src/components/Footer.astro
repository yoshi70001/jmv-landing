---
import { contacto } from '../lib/datos/contacto';

const anio = new Date().getFullYear();

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/historia', texto: 'Historia' },
  { href: '/#identidad', texto: 'Identidad' },
  { href: '/#actividades', texto: 'Actividades' },
  { href: '/formacion', texto: 'Formación' },
  { href: '/blog', texto: 'Bitácora' },
  { href: '/#contacto', texto: 'Contacto' },
];
---

<footer class="bg-marino-noche text-marfil">
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-28 sm:px-6 lg:pb-14">
    <p class="texto-contorno-marfil select-none font-display text-[clamp(3rem,12vw,9rem)] leading-none font-semibold uppercase" aria-hidden="true">
      Jumavi
    </p>

    <nav aria-label="Navegación del pie de página" class="mt-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="font-body text-xs font-bold uppercase tracking-[0.18em] text-marfil/75 transition-colors hover:text-dorado"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-8 flex flex-wrap items-end justify-between gap-6 border-t border-marfil/20 pt-8">
      <div>
        <p class="font-display text-lg font-medium tracking-wide">
          Juventud Mariana Vicentina <span class="text-dorado">✦</span> desde 1830
        </p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-marfil/75">
          Eclesial, laical, mariana y vicenciana. La JMV (JUMAVI) es una asociación
          católica internacional de jóvenes vinculada a la Familia Vicentina,
          presente en 78 países.
        </p>
        <p class="mt-3 text-sm text-marfil/60">
          <a href={contacto.instagram.enlace} target="_blank" rel="noopener noreferrer" class="underline decoration-marfil/30 underline-offset-4 transition-colors hover:text-dorado">
            {contacto.instagram.usuario}
          </a>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href={contacto.facebook.enlace} target="_blank" rel="noopener noreferrer" class="underline decoration-marfil/30 underline-offset-4 transition-colors hover:text-dorado">
            Facebook
          </a>
        </p>
      </div>
      <p class="font-body text-xs font-bold uppercase tracking-[0.2em] text-marfil/55">
        © {anio} JMV · Familia Vicentina
      </p>
    </div>
  </div>
</footer>
