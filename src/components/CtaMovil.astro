---
import { contacto } from '../lib/datos/contacto';
---

<a
  href={contacto.whatsapp.enlace}
  target="_blank"
  rel="noopener noreferrer"
  transition:persist
  class="fixed inset-x-0 bottom-0 z-30 flex min-h-[var(--alto-cta)] items-center justify-center gap-2.5 bg-dorado px-4 pb-[env(safe-area-inset-bottom)] font-body text-sm font-bold uppercase tracking-widest text-tinta shadow-cta lg:hidden"
>
  Únete por WhatsApp
  <span aria-hidden="true">✦</span>
</a>
