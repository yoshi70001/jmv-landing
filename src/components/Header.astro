---
import { contacto } from '../lib/datos/contacto';
import { navegacionPrincipal } from '../lib/datos/navegacion';

const enlaces = navegacionPrincipal;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-tinta/10 bg-marfil/85 backdrop-blur-md" transition:persist>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5 sm:px-6">
    <a
      href="/"
      class="flex items-center gap-2.5"
      aria-label="JUMAVI — ir al inicio"
    >
      <img
        src="/logo-jmv.svg"
        alt=""
        width="44"
        height="44"
        class="size-10 shrink-0 sm:size-11"
      />
      <span class="font-body text-sm font-bold uppercase tracking-amplio text-tinta">
        Jumavi
      </span>
    </a>

    <!-- Nav escritorio -->
    <nav aria-label="Navegación principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          enlaces.map((enlace) => (
            <li>
              <a
                href={enlace.href}
                class="enlace-nav rounded-full px-3 py-2 font-body text-xs font-bold uppercase tracking-etiqueta text-tinta/80 transition-colors hover:bg-celeste-niebla hover:text-marino xl:px-4 xl:text-[0.8rem]"
              >
                {enlace.texto}
              </a>
            </li>
          ))
        }
        <li class="ml-2">
          <a
            href={contacto.whatsapp.enlace}
            target="_blank"
            rel="noopener noreferrer"
            class="boton boton-dorado px-4 py-2 text-xs tracking-etiqueta xl:text-[0.8rem]"
          >
            Únete ✦
          </a>
        </li>
      </ul>
    </nav>

    <!-- Botón hamburguesa (móvil) -->
    <button
      id="boton-menu"
      type="button"
      class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-xl bg-celeste-niebla text-marino transition-colors hover:bg-dorado-suave lg:hidden"
      aria-expanded="false"
      aria-controls="panel-menu"
      aria-label="Abrir menú"
    >
      <span class="barra-menu relative block h-5 w-7" aria-hidden="true">
        <span class="barra absolute left-0 block h-[3px] w-full rounded-full bg-marino"></span>
        <span class="barra absolute left-0 block h-[3px] w-full rounded-full bg-marino"></span>
        <span class="barra absolute left-0 block h-[3px] w-full rounded-full bg-marino"></span>
      </span>
    </button>
  </div>
</header>

<!-- Panel de menú (móvil) -->
<div
  id="panel-menu"
  hidden
  class="fixed inset-0 z-40 overflow-y-auto bg-marino pt-[calc(var(--alto-header)+1.25rem)]"
>
  <nav aria-label="Navegación móvil">
    <ul class="flex min-h-full flex-col px-6 pb-10">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class="flex items-center justify-between border-b border-marfil/15 py-4 font-display text-3xl font-semibold text-marfil transition-colors hover:text-dorado"
            >
              {enlace.texto}
              <span class="text-lg text-celeste" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
      <li class="mt-auto pt-10">
        <a
          href={contacto.whatsapp.enlace}
          target="_blank"
          rel="noopener noreferrer"
          class="boton boton-dorado block px-6 py-4 text-center text-base tracking-widest"
        >
          Únete por WhatsApp ✦
        </a>
      </li>
    </ul>
  </nav>
</div>

<script>
  let tecladoConectado = false;

  /** Elementos del layout que quedan fuera del panel y deben inhabilitarse. */
  function bloquesExteriores() {
    return [document.getElementById('contenido'), document.querySelector('footer')].filter(
      (el): el is HTMLElement => el !== null
    );
  }

  function alternarMenu(boton: Element, panel: Element, abierto: boolean) {
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    panel.toggleAttribute('hidden', !abierto);
    document.body.classList.toggle('overflow-hidden', abierto);
    boton.querySelector('.barra-menu')?.classList.toggle('menu-abierto', abierto);

    // Fuera del panel: nada debe recibir foco de Tab ni leerse en el flujo.
    bloquesExteriores().forEach((el) => el.toggleAttribute('inert', abierto));

    if (abierto) {
      panel.querySelector<HTMLElement>('a')?.focus();
    } else {
      (boton as HTMLElement).focus();
    }
  }

  function conectarMenu() {
    const boton = document.getElementById('boton-menu');
    const panel = document.getElementById('panel-menu');
    if (!boton || !panel) return;

    boton.onclick = () => {
      alternarMenu(boton, panel, boton.getAttribute('aria-expanded') !== 'true');
    };

    panel.querySelectorAll('a').forEach((enlace) => {
      enlace.addEventListener('click', () => alternarMenu(boton, panel, false));
    });

    if (tecladoConectado) return;
    tecladoConectado = true;

    document.addEventListener('keydown', (evento) => {
      const b = document.getElementById('boton-menu');
      const p = document.getElementById('panel-menu');
      if (!b || !p || b.getAttribute('aria-expanded') !== 'true') return;

      if (evento.key === 'Escape') {
        alternarMenu(b, p, false);
        return;
      }

      // Focus trap: el panel es un overlay modal de facto.
      if (evento.key !== 'Tab') return;
      const foco = [
        b,
        ...p.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ];
      const primero = foco[0];
      const ultimo = foco[foco.length - 1];
      const actual = document.activeElement;

      if (evento.shiftKey && (actual === primero || !foco.includes(actual as HTMLElement))) {
        evento.preventDefault();
        ultimo.focus();
      } else if (!evento.shiftKey && actual === ultimo) {
        evento.preventDefault();
        primero.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', conectarMenu);
</script>

<style>
  .barra:nth-child(1) {
    top: 0;
  }

  .barra:nth-child(2) {
    top: 8px;
  }

  .barra:nth-child(3) {
    top: 16px;
  }

  .barra {
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.15s ease;
  }

  .menu-abierto .barra:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .menu-abierto .barra:nth-child(2) {
    opacity: 0;
  }

  .menu-abierto .barra:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
