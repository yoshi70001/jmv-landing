---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JUMAVI — Juventud Mariana Vicentina',
  description =
    '¿Entre 15 y 35 años? Vive tu fe sin dejar de ser tú: comunidad, formación y servicio con la Juventud Mariana Vicentina. Desde 1830, en 78 países y con más de 30 000 jóvenes.',
} = Astro.props;

const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imagen = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="JUMAVI" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JUMAVI — Juventud Mariana Vicentina, para jóvenes de 15 a 35. Desde 1830, en 78 países." />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#1e2f6b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Juventud Mariana Vicentina',
      alternateName: ['JMV', 'JUMAVI'],
      foundingDate: '1830',
      description:
        'Asociación católica internacional juvenil y laical vinculada a la Familia Vicentina, fundada a partir de las apariciones de la Virgen María a Santa Catalina Labouré en 1830.',
      symbol: 'Medalla Milagrosa',
    })} />
    <ClientRouter />
  </head>
  <body class="bg-papel font-body text-tinta antialiased">
    <slot />

    <script>
      function iniciarReveals() {
        const elementos = document.querySelectorAll('[data-reveal]:not(.revelado)');
        if (elementos.length === 0) return;

        const observer = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('revelado');
                observer.unobserve(entrada.target);
              }
            }
          },
          { threshold: 0.12 }
        );

        elementos.forEach((el) => observer.observe(el));
      }

      document.addEventListener('astro:page-load', iniciarReveals);
    </script>
  </body>
</html>
