---
import { ClientRouter } from 'astro:transitions';
// Fuentes variables self-hosted, subset latino (es-PE no necesita más).
// ?url nos da la ruta hasheada para declarar el @font-face y precalentar
// con preload los dos archivos que pinta el primer pantalla.
import fuenteFraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import fuenteFrauncesItalica from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import fuenteSpaceGrotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaMovil from '../components/CtaMovil.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'JUMAVI — Juventud Mariana Vicentina (JMV) | Jóvenes católicos en Perú',
  description =
    '¿Entre 15 y 35 años? Vive tu fe sin dejar de ser tú con la JMV (JUMAVI), Juventud Mariana Vicentina: comunidad, formación y servicio. Desde 1830, en 78 países.',
} = Astro.props;

const url = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const imagen = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://jumavi.org/#organizacion',
  name: 'Juventud Mariana Vicentina',
  alternateName: ['JMV', 'JUMAVI'],
  url: 'https://jumavi.org/',
  logo: 'https://jumavi.org/apple-touch-icon.png',
  image: imagen,
  description:
    'Asociación católica internacional juvenil y laical vinculada a la Familia Vicentina. La JMV vive la fe, se forma, evangeliza y sirve a los más necesitados siguiendo a María y el carisma de San Vicente de Paúl.',
  slogan: 'Vivir la fe sin dejar de ser tú.',
  foundingDate: '1830',
  foundingLocation: {
    '@type': 'Place',
    name: 'París, Francia',
  },
  areaServed: '78 países, incluido el Perú',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Familia Vicentina',
  },
  symbol: 'Medalla Milagrosa',
  sameAs: ['https://instagram.com/jmv_peru', 'https://facebook.com/jmv'],
};

const sitioWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://jumavi.org/#sitio',
  url: 'https://jumavi.org/',
  name: 'JUMAVI — Juventud Mariana Vicentina',
  alternateName: 'JMV',
  inLanguage: 'es-PE',
  publisher: { '@id': 'https://jumavi.org/#organizacion' },
};

/* Misma declaración que fontsource (eje wght), solo subset latino.
   set:html porque <style> no interpola expresiones del frontmatter. */
const cssFuentes = `
@font-face {
  font-family: 'Fraunces Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${fuenteFraunces}') format('woff2-variations');
}
@font-face {
  font-family: 'Fraunces Variable';
  font-style: italic;
  font-display: swap;
  font-weight: 100 900;
  src: url('${fuenteFrauncesItalica}') format('woff2-variations');
}
@font-face {
  font-family: 'Space Grotesk Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 300 700;
  src: url('${fuenteSpaceGrotesk}') format('woff2-variations');
}
`;
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="alternate" type="application/rss+xml" title="Bitácora JUMAVI" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="JUMAVI" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="JUMAVI — Juventud Mariana Vicentina, para jóvenes de 15 a 35. Desde 1830, en 78 países."
    />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#174782" />
    <link rel="preload" href={fuenteFraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteSpaceGrotesk} as="font" type="font/woff2" crossorigin />
    <style is:global set:html={cssFuentes} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizacion)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sitioWeb)} />
    <ClientRouter />
  </head>
  <body class="bg-marfil font-body text-tinta antialiased">
    <a
      href="#contenido"
      class="fixed top-3 left-3 z-[70] -translate-y-24 rounded-full bg-marino px-5 py-3 font-body text-sm font-bold text-marfil shadow-nube-lg transition-transform focus:translate-y-0"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CtaMovil />

    <script>
      // Navegaciones internas: una sola capa de animación (el crossfade de la
      // view transition); las reveals escalonadas quedan para la carga inicial.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('sin-reveal');
      });

      function iniciarReveals() {
        const elementos = document.querySelectorAll('[data-reveal]:not(.revelado)');
        if (elementos.length === 0) return;

        const observer = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('revelado');
                observer.unobserve(entrada.target);
              }
            }
          },
          { threshold: 0.12 }
        );

        elementos.forEach((el) => observer.observe(el));
      }

      // Desplazamiento suave solo para anclas de la misma página:
      // entre páginas lo maneja la view transition (scroll-behavior: auto).
      function scrollSuaveAnclas() {
        document.querySelectorAll('a[href*="#"]').forEach((nodo) => {
          const enlace = nodo as HTMLAnchorElement;
          enlace.addEventListener('click', (evento) => {
            const url = new URL(enlace.href, location.href);
            if (url.pathname !== location.pathname || url.hash === '') return;
            const destino = document.querySelector(url.hash);
            if (!destino) return;
            evento.preventDefault();
            destino.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', url.hash);
          });
        });
      }

      document.addEventListener('astro:page-load', () => {
        iniciarReveals();
        scrollSuaveAnclas();
      });
    </script>
  </body>
</html>
